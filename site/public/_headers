# no-transform keeps Cloudflare from changing the HTML on its way out. Free plans otherwise get its RUM analytics
# beacon added to every page. It also turns off compression, so the stylesheet and images drop it below.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/style.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/img/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

/ferrisping.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
